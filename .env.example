APP_URL=http://noteselot.130.130.10.18.sslip.io
# Generate with: openssl rand -hex 32
# Use a hex value so the database URL does not need percent-encoding.
POSTGRES_PASSWORD=replace_with_a_random_64_character_hex_value
ALLOW_REGISTRATION=true
# One trusted reverse-proxy hop in front of the application (Coolify).
TRUST_PROXY=1
